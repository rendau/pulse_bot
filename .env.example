# пример окружения pulse_bot (весь env в проде — в kusec, app pulse)
LOG_LEVEL=info
SYSTEM_HTTP_PORT=3015

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
# кому можно /eval (прогон эталонных вопросов агента)
TELEGRAM_ADMIN_USERS=

# pulse_agent: адрес и ключ бота в API_KEYS агента
AGENT_URL=http://localhost:9092
AGENT_KEY=devkey
AGENT_TIMEOUT=6m
